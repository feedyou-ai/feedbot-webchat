{
  "name": "@feedyou-ai/feedbot-webchat-v0",
  "version": "0.14.1-20",
  "description": "Embeddable web chat control for the Microsoft Bot Framework modified by Feedyou",
  "main": "built/BotChat.js",
  "types": "built/BotChat.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "analyze-bundle": "source-map-explorer 'botchat-es5.js'",
    "build-test": "cd test && npm run build",
    "typecheck": "tsc -p .",
    "build-lib": "node scripts/build/build-lib.js",
    "build-css": "sass --no-source-map --style=expanded --silence-deprecation=import ./src/scss/:. && rimraf ./includes/",
    "build": "npm run typecheck && npm run build-lib && npm run build-css && rspack build --mode development",
    "build:release": "npm run typecheck && npm run clean && npm run build-lib && npm run build-css && rspack build --mode production",
    "verify:build": "node scripts/verify-build.js",
    "watch": "rspack build --mode development --watch",
    "clean": "rimraf built",
    "prepublishOnly": "npm run build:release",
    "prepare": "patch-package",
    "start": "http-server -p 8000",
    "dev": "node scripts/dev-server/server.js",
    "test": "cd test && npm test",
    "mock": "cd test && npm start",
    "install-test": "cd test && npm install"
  },
  "repository": {
    "type": "git",
    "url": "git://git@github.com/feedyou-ai/feedbot-webchat.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/feedyou-ai"
  },
  "author": "Microsoft Corp",
  "license": "MIT",
  "dependencies": {
    "@swc/helpers": "0.5.23",
    "@types/debounce": "^1.2.4",
    "@types/google.analytics": "0.0.40",
    "@types/html2canvas": "0.0.36",
    "adaptivecards": "^1.1.0",
    "bluebird": "^3.5.1",
    "botframework-directlinejs": "0.9.15",
    "classnames": "^2.3.1",
    "core-js": "^2.4.1",
    "debounce": "^1.2.1",
    "downshift": "^9.0.7",
    "fuzzysort": "^1.9.0",
    "html2canvas": "^1.0.0-rc.7",
    "isomorphic-fetch": "^3.0.0",
    "jspeech": "^0.1.1",
    "markdown-it": "8.3.1",
    "microsoft-speech-browser-sdk": "0.0.12",
    "react": "16.12.0",
    "react-dom": "16.12.0",
    "react-redux": "5.0.5",
    "redux": "3.7.2",
    "redux-observable": "0.13.0",
    "rgb2hex": "^0.2.5",
    "rxjs": "5.4.3",
    "simple-update-in": "^1.2.0",
    "smartsupp-websocket": "^1.1.0",
    "sweetalert2": "^11.17.2",
    "tslib": "1.7.1"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@rspack/cli": "2.2.8",
    "@rspack/core": "2.2.8",
    "@swc/core": "1.16.13",
    "@types/markdown-it": "0.0.2",
    "@types/react": "15.6.1",
    "@types/react-dom": "15.5.7",
    "@types/react-redux": "5.0.5",
    "acorn": "8.18.0",
    "acorn-walk": "8.3.5",
    "expose-loader": "5.0.1",
    "http-server": "^0.10.0",
    "jsdom": "30.1.1",
    "patch-package": "^5.1.2",
    "prettier": "^2.4.1",
    "process": "0.11.10",
    "punycode": "1.4.1",
    "rimraf": "2.6.1",
    "sass": "1.105.0",
    "setimmediate": "1.0.5",
    "source-map-explorer": "^2.5.2",
    "timers-browserify": "2.0.4",
    "typescript": "5.9.3"
  },
  "files": [
    "built/",
    "adaptivecards-hostconfig.json",
    "botchat-fullwindow.css",
    "botchat-redesign.css",
    "botchat.css",
    "botchat.js",
    "botchat.js.map",
    "botchat-es5.js",
    "botchat-es5.js.map",
    "CognitiveServices.js",
    "CognitiveServices.js.map"
  ]
}
